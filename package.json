{
  "name": "personal-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "dev:fixtures": "node scripts/run-fixtures.mjs dev",
    "typecheck": "node scripts/run-fixtures.mjs production-typecheck",
    "typecheck:fixtures": "node scripts/run-fixtures.mjs typecheck",
    "lint": "eslint .",
    "validate:content": "node scripts/validate-content.mjs",
    "test:content": "node --test scripts/content.test.mjs",
    "test:publication": "node --test scripts/publication.test.mjs",
    "test:build": "node scripts/test-isolated-build.mjs",
    "build": "npm run validate:content && npm run typecheck && react-router build --mode production && node scripts/finalize-publication.mjs && npm run check:build",
    "build:release": "node scripts/build-release.mjs",
    "check:build": "node scripts/check-build.mjs",
    "preview": "vite preview --outDir build/client",
    "check:privacy": "node scripts/check-privacy.mjs",
    "test:privacy": "node --test scripts/privacy.test.mjs"
  },
  "dependencies": {
    "@react-router/node": "8.5.0",
    "isbot": "5.2.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@react-router/dev": "8.5.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5"
  },
  "engines": {
    "node": "24.x"
  }
}
